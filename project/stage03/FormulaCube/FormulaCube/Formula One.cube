  <MdxScripts>
    <MdxScript dwd:design-time-name="04e07634-8456-4197-befa-689e72c29ae2">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;     
CREATE MEMBER CURRENTCUBE.Measures.[Race Time Formatted]
AS
IIF(
    ISEMPTY([Measures].[Race Time Milliseconds]) OR [Measures].[Race Time Milliseconds] &lt;= 0,
    NULL,
    Format(Fix([Measures].[Race Time Milliseconds] / 3600000), "00") + ":" +
    Format(
        Fix(
            (
                [Measures].[Race Time Milliseconds] - (3600000 * Fix([Measures].[Race Time Milliseconds] / 3600000)) -- This is Milliseconds MOD 3600000
            ) / 60000
        ),
        "00"
    ) + ":" +
    Format(
        Fix(
            (
                [Measures].[Race Time Milliseconds] - (60000 * Fix([Measures].[Race Time Milliseconds] / 60000)) -- This is Milliseconds MOD 60000
            ) / 1000
        ),
        "00"
    ) + "." +
    Format(
        [Measures].[Race Time Milliseconds] - (1000 * Fix([Measures].[Race Time Milliseconds] / 1000)), -- This is Milliseconds MOD 1000
        "000"
    )
),
VISIBLE = 1;    
CREATE MEMBER CURRENTCUBE.[Measures].[Absolute Position Order Change]
 AS Abs([Measures].[Position Order Change]), 
VISIBLE = 1;       
CREATE MEMBER CURRENTCUBE.[Measures].AveragePitStopsCount
 AS Divide ( 
    [Measures].[Number of Pit Stops],
    [Measures].[Number of Pit Stops Count]
), 
VISIBLE = 1;       
CREATE MEMBER CURRENTCUBE.[Measures].[% Finished Races]
 AS IIF(
    IsEmpty( ([Measures].[Fact Result Count], [Dim Status].[StatusDescription].[All]) )
    OR ( ([Measures].[Fact Result Count], [Dim Status].[StatusDescription].[All]) = 0 ),
    NULL,
    (
        [Measures].[Fact Result Count],
        [Dim Status].[StatusDescription].&amp;[Finished] 
    )
    /
    (
        [Measures].[Fact Result Count],
        [Dim Status].[StatusDescription].[All] 
    )
), 
VISIBLE = 1;    
CREATE MEMBER CURRENTCUBE.[Measures].[Average Absolute Position Order Change]
 AS DIVIDE(SUM([Measures].[Absolute Position Order Change]), [Measures].[Fact Result Count]), 
VISIBLE = 1; 
CREATE MEMBER CURRENTCUBE.[Measures].[Average Points]
 AS DIVIDE(SUM([Measures].[Points Scored]), [Measures].[Fact Result Count]), 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>